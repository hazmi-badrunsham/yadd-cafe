<section
  class="relative overflow-hidden border-b border-black/10"
  aria-labelledby="hero-heading"
>
  <div
    class="mx-auto grid min-h-[calc(100svh-4rem)] max-w-7xl grid-cols-1 lg:grid-cols-2"
  >
    <!-- Text -->
    <div
      class="flex flex-col justify-center px-5 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24"
    >
      <div class="max-w-xl">
        <p
          class="mb-6 font-mono text-[11px] uppercase tracking-[0.18em] text-text-muted"
        >
          YADD'S CAFE
        </p>

        <h1
          id="hero-heading"
          class="break-words font-display text-[3.75rem] font-semibold uppercase leading-[0.85] tracking-[-0.02em] text-text sm:text-[5.5rem] md:text-[6.5rem] lg:text-[8rem]"
        >
          [HERO<br />
          HEADLINE]
        </h1>

        <p
          class="mt-8 max-w-md text-sm leading-7 text-text-muted sm:text-base"
        >
          [HERO SUBTITLE]
        </p>

        <div class="mt-8">
          <a
            href="#menu"
            class="inline-flex min-h-11 items-center justify-center bg-text px-6 py-3 font-mono text-xs uppercase tracking-[0.12em] text-background transition-opacity hover:opacity-80"
          >
            [PRIMARY CTA]
          </a>
        </div>
      </div>
    </div>

    <!-- Image -->
    <div class="relative min-h-[420px] bg-surface sm:min-h-[520px] lg:min-h-0">
      <img
        src="/images/hero.jpeg"
        alt="YAD'D'S CAFE"
        onerror="this.hidden = true"
        class="absolute inset-0 h-full w-full object-cover"
      />

      <div
        class="absolute inset-0 bg-black/5"
        aria-hidden="true"
      ></div>
    </div>
  </div>
</section>