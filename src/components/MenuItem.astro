---
interface Props {
  name: string;
  description: string;
  price: string;
}

const { name, description, price } = Astro.props;
---

<li class="grid grid-cols-[minmax(0,1fr)_auto] gap-4 border-t border-black/10 py-5 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-8">
  <div>
    <h3 class="break-words font-display text-2xl font-medium uppercase leading-none text-text">
      {name}
    </h3>
    <p class="mt-2 max-w-md text-sm leading-6 text-text-muted">
      {description}
    </p>
  </div>

  <p class="pt-1 font-mono text-sm text-text">{price}</p>
</li>