<header class="relative z-50 border-b border-black/10 bg-background">
  <nav
    class="mx-auto flex min-h-16 max-w-7xl items-center justify-between px-5 sm:px-8 lg:px-10"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="font-brand text-base font-semibold tracking-[0.12em] text-text sm:text-lg"
      aria-label="YADD'S CAFE home"
    >
      YADD'S CAFE
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <a
        href="#menu"
        class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Menu
      </a>

      <a
        href="#location"
        class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Location
      </a>

      <a
        href="#contact"
        class="font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Contact
      </a>
    </div>

    <button
      id="nav-toggle"
      type="button"
      class="flex h-11 w-11 items-center justify-center rounded-full border border-black/10 md:hidden"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="flex w-5 flex-col gap-1.5">
        <span class="h-px w-full bg-text"></span>
        <span class="h-px w-full bg-text"></span>
      </span>
    </button>
  </nav>

  <div
    id="mobile-menu"
    class="hidden border-t border-black/10 bg-background md:hidden"
  >
    <div class="mx-auto flex max-w-7xl flex-col px-5">
      <a
        href="#menu"
        class="flex min-h-11 items-center border-b border-black/10 py-4 font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Menu
      </a>
      <a
        href="#location"
        class="flex min-h-11 items-center border-b border-black/10 py-4 font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Location
      </a>
      <a
        href="#contact"
        class="flex min-h-11 items-center py-4 font-mono text-xs uppercase tracking-[0.12em] text-text-muted transition-colors hover:text-text"
      >
        Contact
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const links = menu.querySelectorAll('a');

    const closeMenu = () => {
      menu.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open navigation menu');
      document.body.style.removeProperty('overflow');
    };

    const openMenu = () => {
      menu.classList.remove('hidden');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close navigation menu');
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      isOpen ? closeMenu() : openMenu();
    });

    links.forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });

    // Keep the menu in sync if the viewport is resized past the md breakpoint.
    const mql = window.matchMedia('(min-width: 768px)');
    mql.addEventListener('change', (event) => {
      if (event.matches) closeMenu();
    });
  }
</script>