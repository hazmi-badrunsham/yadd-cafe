---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Yadd's Cafe",
  description = "Yadd's Cafe — a small roadside cafe in Kedah.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="description" content={description} />

    <meta name="theme-color" content="#f9f8f6" />

    <link rel="icon" href="/fav.svg" type="image/svg+xml" />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>